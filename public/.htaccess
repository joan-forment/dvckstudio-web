# Hostinger (LiteSpeed / Apache). Mirrors the redirects in vercel.json.

Options -MultiViews -Indexes
DirectoryIndex index.html
# /studio must not be redirected to /studio/ (canonical URLs have no slash).
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.dvckstudio.com -> dvckstudio.com
  RewriteCond %{HTTP_HOST} ^www\.dvckstudio\.com$ [NC]
  RewriteRule ^(.*)$ https://dvckstudio.com/$1 [L,R=301]

  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [L,R=301]

  # /studio/index.html -> /studio (otherwise the rule below leaves /studio/index)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)/index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # /page.html -> /page (only for URLs typed or linked with .html)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # Asset folders with no page (/home, /icons, /fonts…) are a 404. The server
  # adds a trailing slash to folders and the rule below would strip it again,
  # which looped forever (/home -> /home/ -> /home).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html !-f
  RewriteRule ^(.+?)/?$ - [R=404,L]

  # /page/ -> /page
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # /blog/post/ -> /blog/post (pages that are only a .html file, no folder)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # /page -> page.html (internal)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed build files never change.
  SetEnvIf Request_URI "^/(assets|fonts|draco)/" long_cache
  Header set Cache-Control "public, max-age=31536000, immutable" env=long_cache
</IfModule>
